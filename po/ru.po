#: gnome-extension/prefs.js:71
#, no-javascript-format
msgid "About"
msgstr "О программе"

#: gnome-extension/prefs.js:72
#, no-javascript-format
msgid "Isle {version}"
msgstr "Isle {version}"

#: gnome-extension/prefs.js:73
#, no-javascript-format
msgid ""
"A notch-style island for GNOME. © 2026 zickrian, free software under the GPL."
msgstr ""
"«Остров» в верхней панели GNOME. © 2026 zickrian, свободная программа под "
"лицензией GPL."

#: gnome-extension/prefs.js:83
#, no-javascript-format
msgid "Features, installing and updating"
msgstr "Возможности, установка и обновление"

#: gnome-extension/prefs.js:83
#, no-javascript-format
msgid "Website"
